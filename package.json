{
  "name": "battle-crab",
  "version": "0.1.0",
  "private": true,
  "description": "Battle Crab: a third-person hermit crab that builds a weapon platform on its shell. Drawn by the Gridfall Engine.",
  "author": "Slayd Games",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sfx.mjs && vite",
    "dev:engine": "node scripts/sfx.mjs && cross-env-shell ENGINE_SOURCE=1 vite",
    "build": "node scripts/sfx.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:pages": "node scripts/sfx.mjs && tsc --noEmit && vite build --base=/battle-crab/",
    "deploy": "npm run build:pages && gh-pages -d dist -b gh-pages --nojekyll -m \"Deploy to GitHub Pages\"",
    "sfx": "node scripts/sfx.mjs"
  },
  "dependencies": {
    "gridfall-engine": "github:EdSpurrier/gridfall-engine#v0.76.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "gh-pages": "^6.3.0"
  }
}
